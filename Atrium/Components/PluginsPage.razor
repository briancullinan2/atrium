@page "/plugins"
@implements IDisposable
@implements IHasForms
@implements IHasCover
@attribute [Display(Name = "System Components", ShortName = "Plugins", GroupName = "Administration", Prompt = "bi-puzzle-fill")]
@inject ICompositeProvider Composite

@code {



    public void Dispose()
    {
        GC.SuppressFinalize(this);
    }

    public static (Assembly? Assembly, string? RoutableType) TryGetRoots(TrustedLoader? Trust)
    {
        var likelyRootAss = TrustedLoader.Routable
            .FirstOrDefault(ass => Trust?.EnabledAssemblies.ContainsKey(ass.ToName()) == true)
            ?? TrustedLoader.Routable.FirstOrDefault();

        var likelyRoute = TrustedLoader.Roots[0].AssemblyQualifiedName
            ?? TrustedLoader.AllRoutes.FirstOrDefault(t => t.Assembly == likelyRootAss)?.AssemblyQualifiedName
            ?? TrustedLoader.AllRoutes[0].AssemblyQualifiedName;

        return (Assembly: likelyRootAss, RoutableType: likelyRoute);
    }




    protected static async Task NotifyAssembly(TrustedLoader? Trust, string? file, TrustedState? gatherTrust, ICompositeProvider? Composite)
    {
        // 1. Immediate Throttled UI Update (Max every 200ms)
        // This keeps the UX fluid without flooding the RenderTree
        if (gatherTrust == null) return;
        if (gatherTrust.LastUpdate == null 
            || (DateTime.Now - gatherTrust.LastUpdate.Value).TotalMilliseconds > 200)
        {
            gatherTrust.Scanning = file;
            gatherTrust.LastUpdate = DateTime.Now;
            gatherTrust.ScanningRendered = await RenderPluginStatus(gatherTrust.IsBootstrapping, gatherTrust.Error, gatherTrust.Scanning).ToHtml(Composite);
            gatherTrust.PluginControls = await NotifySettled(
                Trust, gatherTrust).ToHtml(Composite);
            if (Composite?.GetService<IHasChildren>()?.HasChanged(Composite) is Task task) await task;
        }
    }



    protected static RenderFragment NotifySettled(
        TrustedLoader? Trust,
        TrustedState? gatherTrust
    ) => __builder =>
    {
        if (gatherTrust == null) return;

        RenderPluginSelect(
            gatherTrust.Layouts,
            gatherTrust.Routable,
            gatherTrust.CatchAll,
            gatherTrust.Roots,
            gatherTrust.AllRoutes)(__builder);

        foreach (var plugin in gatherTrust.MyList ?? [])
        {
            List<string>? requiredBy = null;
            Trust?.DependedAssemblies.TryGetValue(plugin.Title, out requiredBy);
            RenderPluginContract(plugin, requiredBy, GetActive(Trust, plugin))(__builder);
        
        }
    };


    public class TrustedState(TrustedLoader? Trust) : IDisposable
    {
        public List<Type>? Layouts { get; set; }
        public List<Assembly>? Routable { get; set; }
        public List<Type>? CatchAll { get; set; }
        public List<Type>? Roots { get; set; }
        public List<Type>? AllRoutes { get; set; }
        public bool? IsBootstrapping { get; set; }
        public string? Error { get; set; }
        public List<PluginContract>? MyList { get; set; }
        public DateTime? LastUpdate { get; set; }
        public string? Scanning { get; set; }
        public string? ScanningRendered { get; set; }
        public string? PluginControls { get; set; }
        public Action<PluginContract?>? NotifyDelegate = null;
        public void Dispose()
        {
            Trust?.OnAssemblyLoaded -= this.NotifyDelegate;
        }
    }



    public static TrustedState? GatherTrust(TrustedLoader? Trust, Atrium.Components.PluginsPage? Plugin, ICompositeProvider? Composite)
    {
        if (Plugin == null) return null;

        Plugin.GatheredTrust ??= new TrustedState(Trust);

        Plugin.GatheredTrust?.Layouts = TrustedLoader.Layouts.ToList();
        Plugin.GatheredTrust?.Routable = TrustedLoader.Routable.ToList();
        Plugin.GatheredTrust?.CatchAll = TrustedLoader.CatchAll.ToList();
        Plugin.GatheredTrust?.Roots = TrustedLoader.Roots.ToList();
        Plugin.GatheredTrust?.AllRoutes = TrustedLoader.AllRoutes.ToList();
        Plugin.GatheredTrust?.IsBootstrapping = TrustedLoader.IsBootstrapping;
        Plugin.GatheredTrust?.Error = TrustedLoader.Error;
        Plugin.GatheredTrust?.MyList = Trust?.DiscoveredStatus.Values.OrderBy(p => p.Title).ToList();
        if (Plugin.GatheredTrust?.NotifyDelegate == null)
        {
            Plugin.GatheredTrust?.NotifyDelegate ??= async (PluginContract? file) =>
                {
                    await NotifyAssembly(Trust, file?.InstallPath, Plugin.GatheredTrust, Composite);
                };

            Trust?.OnAssemblyLoaded += Plugin.GatheredTrust?.NotifyDelegate;
        }

        return Plugin.GatheredTrust;
    }


    protected TrustedState? GatheredTrust { get; set; } = null;

    public static async Task<RenderFragment> RenderMain(
        TrustedLoader? Trust, 
        IHasClass? Logo, 
        IHasChildren? Main,
        Atrium.Components.PluginsPage? Plugin,
        IWindowManager? Window,
        ICompositeProvider? Composite
    )
    {
        // prevent concurrency errors while printing the view
        Plugin?.GatheredTrust = GatherTrust(Trust, Plugin, Composite);

        if (Plugin?.GatheredTrust == null) return __builder => { };

        var SetRoutable = async (ChangeEventArgs item) => {
            if (item.Value is string key
                && Trust?.LoadedAssemblies.TryGetValue(key, out var ass) == true)
                if (Main?.SetAppAssembly(ass) is Task task) await task;
        };

        Func<Task>? OnSettled = null;
        OnSettled = async () =>
        {
            Trust?.OnSettledAsync += OnSettled;

            Plugin.GatheredTrust = GatherTrust(Trust, Plugin, Composite);
            if (Plugin.GatheredTrust == null) return;
            await NotifyAssembly(Trust, "", Plugin.GatheredTrust, Composite);

            Plugin.GatheredTrust.PluginControls = await NotifySettled(
                Trust, Plugin.GatheredTrust).ToHtml(Composite);
            if (Composite?.GetService<IHasChildren>()?.HasChanged(Composite) is Task task) await task;
        };

        if (Plugin.GatheredTrust.ScanningRendered == null)
            await NotifyAssembly(Trust, "", Plugin.GatheredTrust, Composite);

        if (Plugin.GatheredTrust.PluginControls == null)
            await OnSettled();

        return __builder =>
        {

            <article class="content course-container">

                @Logo?.LogoContent

                <table>
                    <tbody>

                        @(new MarkupString(Plugin.GatheredTrust.ScanningRendered ?? string.Empty))

                        @(new MarkupString(Plugin.GatheredTrust.PluginControls ?? string.Empty))
                        
                    </tbody>
                </table>

            </article>

        };
    }



    public static RenderFragment RenderPluginContract(PluginContract? plugin, List<string>? requiredBy, bool? Checked)
        => __builder =>
        {
            <tr>
                <td class="name-col">
                    <strong>@plugin?.Title</strong><br />
                    <span class="product-tag">@plugin?.Metadata.Product</span>
                </td>

                <td class="meta-col">
                    <small>Pkg: @plugin?.Metadata.Package</small><br />
                    <small>Pub: @plugin?.Metadata.Company @plugin?.Metadata.Publisher</small>
                </td>

                <td class="enable-col">
                    @if (requiredBy != null && requiredBy.Count > 0)
                    {
                        <label class="switch" aria-disabled="true">
                            <input type="checkbox" disabled="disabled" checked="checked" />
                        </label>
                        <span>Required By:</span><br />
                        @foreach (var required in requiredBy)
                        {
                            <span>@required</span><br />
                        }
                    }
                    else
                    {
                        <label class="switch">
                            <input type="checkbox" onchange="window.Atrium.Services.PageManager.TriggerEvent('TogglePlugin', ['@plugin?.Title', !!this.value])" checked="@Checked" />
                        </label>
                    }
                </td>
            </tr>
        };



    public static RenderFragment RenderPluginStatus(bool? IsBootstrapping, string? Error, string? Scanning)
    {
        var message = Error != null
            ? Error 
            : IsBootstrapping == true 
            ? ("Scanning plugins... " + Scanning) 
            : "Ready";

       return __builder =>
       {
           <tr>
               <td colspan="3" class="status-container">
                   <button class="cta">Save and Continue</button><br />
                   <span class="box-status">
                       @message
                   </span>
               </td>
           </tr>
       };
    }


    public static RenderFragment RenderPluginSelect(
        List<Type>? Layouts, 
        List<Assembly>? Routable,
        List<Type>? CatchAll,
        List<Type>? Roots,
        List<Type>? AllRoutes)
        => __builder =>
        {

            @if (Layouts?.Count > 0)
            {
                @RenderSelectTypes(Layouts, "Layout")
            }

            @if (Routable?.Count > 0)
            {
                @RenderSelectAssembly(Routable, "Routable")
            }

            @if (CatchAll?.Count > 0)
            {
                @RenderSelectTypes(CatchAll, "Catch All")
            }

            @if (Roots?.Count > 0 || AllRoutes?.Count > 0)
            {
                @RenderSelectTypes([.. Roots ?? [], .. AllRoutes ?? []], "Root Component")
            }

        };


    public static RenderFragment RenderSelectTypes(IEnumerable<Type>? selectTypes, string? label)
        => __builder =>
        {
            <tr>
                <td colspan="3">
                    <span>@label</span><br />
                    <select onchange="">
                        <option value="">No @label</option>
                        @foreach (var layoutType in selectTypes ?? [])
                        {
                            <option value="@layoutType.AssemblyQualifiedName">@(layoutType.Name ?? layoutType.FullName)</option>
                        }
                    </select>
                </td>
            </tr>
        };

        
    public static RenderFragment RenderSelectAssembly(IEnumerable<Assembly>? selectTypes, string? label)
        => __builder =>
        {
            <tr>
                <td colspan="3">
                    <span>@label</span><br />
                    <select onchange="window.Atrium.Services.PageManager.TriggerEvent('TogglePlugin', this.value)">
                        <option value="">No @label</option>
                        @foreach (var layoutType in selectTypes ?? [])
                        {
                            var name = layoutType.GetName().Name ?? layoutType.GetName().FullName;
                            <option value="@name">@name</option>
                        }
                    </select>
                </td>
            </tr>
        };


    public static bool GetActive(ITrustProvider? Trust, PluginContract e)
    {
        if (Trust?.EnabledAssemblies.ContainsKey(e.Title) == true)
            return true;
        if (Trust?.LoadedAssemblies.ContainsKey(e.Title) == true)
            return true;
#if !BROWSER
        // TODO: use ISettings
        if (Microsoft.Maui.Storage.Preferences.Default.Get("PluginEnabled" + e.Title, false))
            return true;
#endif
        return false;
    }

    public static async Task<string?> OnEnabled(
        TrustedLoader? Trust, 
        string? title,
        bool? isChecked)
    {
        if (title == null) return null;

        if (isChecked != true)
            Trust?.Disable(title);
        else
            Trust?.Enable(title);

        Trust?.OnSettled += () => TriggerExpand(Trust, null);

        return TrustedLoader.Error;
    }


    protected static void TriggerExpand(ITrustProvider? Trust, IWindowManager? window)
    {
        if (Trust?.EnabledAssemblies.Count == 0)
            _ = window?.ExpandWindow(false);
        else
            _ = window?.ExpandWindow(true);
    }



}
