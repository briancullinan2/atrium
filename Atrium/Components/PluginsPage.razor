@page "/plugins"
@implements IHasForms
@implements IHasCover
@attribute [Display(Name = "System Components", ShortName = "Plugins", GroupName = "Administration", Prompt = "bi-puzzle-fill")]

@code {

    public class PluginsState
    {
        [JsonPropertyName(nameof(PreviousRendered))]
        public string PreviousRendered { get; set; } = string.Empty;
        [JsonPropertyName(nameof(LastUpdate))]
        public DateTime? LastUpdate { get; set; } = null;
        [JsonPropertyName(nameof(ScanningRendered))]
        public string ScanningRendered { get; set; } = string.Empty;
        [JsonPropertyName(nameof(PluginSelect))]
        public string PluginSelect { get; set; } = string.Empty;
        [JsonPropertyName(nameof(DisplayPlugins))]
        public Dictionary<string, string> DisplayPlugins { get => EnabledPlugins?.ToDictionary(t => t.AssemblyQualifiedName ?? t.FullName ?? t.Name, t => t.Name) ?? []; }
        [JsonIgnore]
        public List<Type>? EnabledPlugins { get; set; } = null;

    }


    public static PluginsState CachedState { get; } = new ();


    [RequiresAssemblyFiles()]
    public static async Task CheckStatus(ICompositeProvider? Composite, TrustedState? State)
    {
        List<Type>? copy = null;

        lock (CachedState)
            if (CachedState.EnabledPlugins != null)
                copy = [.. CachedState.EnabledPlugins];

        if (copy == null)
        {
            copy = await GetEnabledPlugins(Composite, State);
            lock (CachedState)
                CachedState.EnabledPlugins = copy;
        }


    }

    // TODO: use this on service startup? way to bootstrap another container?
    public static async Task<List<Type>> GetEnabledPlugins(
        ICompositeProvider? service,
        TrustedState? State
    ) {
        if (service == null) return [];
        List<Type>? copy = null;
            copy = [.. State?.AllPlugins ?? []];

        List<Type> enabledPlugins = [];
        foreach (var plugin in copy ?? [])
        {
            var myDelegate = plugin.GetProperty(nameof(IHasPlugins.Installed), BindingFlags.Static | BindingFlags.Public)?.GetValue(null) as Delegate;
            if (myDelegate == null || typeof(Task<string?>).IsAssignableFrom(Nullable.GetUnderlyingType(myDelegate.Method.ReturnType)
                ?? myDelegate?.Method.ReturnType) != true)
                throw new InvalidOperationException("IHasPlugins.Installed delegate must return a Task<string?> with the name of the setting it used to check if its installed or not" + myDelegate?.Method);
            var result = myDelegate.InvokeService(service);
            if (result is Task task)
            {
                await task;
#pragma warning disable IDE0260 // VS fucks up on dynamics
                if ((result as dynamic)?.Result == true)
                    enabledPlugins.Add(plugin);
#pragma warning restore IDE0260 // VS fucks up on dynamics
            }
        }
        return enabledPlugins;
    }


    // TODO: now the goal, limit the number of copies of trusted display information we're pulling

    public static async Task OnSettled(
        ICompositeProvider? Composite, 
        TrustedState? State,
        PluginsState? Plugins,
        string? file)
    {
        var Trust = Composite?.GetService<TrustedLoader>();
        Trust?.OnSettledAsync += OnSettled;


        if (Plugins?.ScanningRendered != null
            && (Plugins?.LastUpdate != null
            && Plugins?.LastUpdate.Value > (DateTime.Now - TimeSpan.FromMilliseconds(200))))
            return;

        Plugins?.LastUpdate = DateTime.Now;

        Plugins?.ScanningRendered = await RenderPluginStatus(State).ToHtml(Composite);
        Plugins?.PluginSelect = await RenderPluginSelect(State).ToHtml(Composite);
        Plugins?.PreviousRendered = await RenderPluginContract(State).ToHtml(Composite);
        var RenderedMain = RenderMainBody(Composite?.GetService<IHasClass>(), Plugins);

        // in case something loaded not from use input/page event
        var Window = Composite?.GetService<IWindowManager>();
        var expand = State?.EnabledAssemblies.Count == 0
            && State.SystemEnabledAssemblies.Count == 0;
        if (Window != null)
            Window?.ExpandWindow(expand);

        var Page = Composite?.GetService<PageManager>();
        if (Page == null) return;
        //if (Composite?.GetService<Components.MainLoader>()?.MainContent == null) return;
        //await Page.Replace(".plugin-status, .plugin-controls", Plugins?.ScanningRendered + Plugins?.PluginSelect);
        //await Page.Insert("#plugins-list > tbody", Plugins?.PreviousRendered);

        
        
    }



    public static RenderFragment RenderMainBody(IHasClass? Logo, PluginsState? State)
        => __builder =>
        {

            <article class="content course-container">

                @*@Logo?.LogoContent*@

                <table id="plugins-list">
                    <tbody>

                        @(new MarkupString(State?.ScanningRendered ?? string.Empty))

                        @(new MarkupString(State?.PluginSelect ?? string.Empty))

                        @(new MarkupString(State?.PreviousRendered ?? string.Empty))

                    </tbody>
                </table>

            </article>

        };

        


    public static RenderFragment RenderPluginContract(
        TrustedState? Trust
    ) => __builder =>
    {
        var copy = Trust?.DiscoveredStatus.Values.ToList() ?? [];
        @foreach (var plugin in copy)
        {
            List<string>? requiredBy = null;
            Trust?.DependedAssemblies?.TryGetValue(plugin.Title, out requiredBy);
            var isChecked = GetActive(Trust?.LoadedAssemblies, Trust?.EnabledAssemblies, plugin.Title);

            <tr data-id="@plugin?.Title">
                <td class="name-col">
                    <strong>@plugin?.Title</strong><br />
                    <span class="product-tag">@plugin?.Metadata.Product</span>
                </td>

                <td class="meta-col">
                    <small>Pkg: @plugin?.Metadata.Package</small><br />
                    <small>Pub: @plugin?.Metadata.Company @plugin?.Metadata.Publisher</small>
                </td>

                <td class="enable-col">
                    @if (requiredBy != null && requiredBy.Count > 0)
                    {
                        <label class="switch" aria-disabled="true">
                            <input type="checkbox" disabled="disabled" checked="checked" />
                        </label>
                        <span>Required By:</span><br />
                        @foreach (var required in requiredBy)
                        {
                            <span>@required</span><br />
                        }
                    }
                    else
                    {
                        <label class="switch">
                            <input type="checkbox" onchange="window.Atrium.Services.PageManager.TriggerEvent('TogglePlugin', ['@plugin?.Title', !!this.value])" checked="@isChecked" />
                        </label>
                    }
                </td>
            </tr>
        }
    };



    public static RenderFragment RenderPluginStatus(TrustedState? State)
    {
        if (State == null) return __builder => { };

        var (IsBootstrapping, Error, Scanning) = State;
        var message = Error != null
            ? Error 
            : IsBootstrapping == true 
            ? ("Scanning plugins... " + Scanning) 
            : "Ready";

       return __builder =>
       {
           <tr class="plugin-status">
               <td colspan="3" class="status-container">
                   <button class="cta">Save and Continue</button><br />
                   <span class="box-status">
                       @message
                   </span>
               </td>
           </tr>
       };
    }


    public static RenderFragment RenderPluginSelect(TrustedState? State)
        => __builder =>
        {
            if (State == null) return;

            var (Layouts, Routable, CatchAll, Roots, AllRoutes) = State;

            @if (Layouts?.Count > 0)
            {
                @RenderSelectTypes(Layouts, "Layout")
            }

            @if (Routable?.Count > 0)
            {
                @RenderSelectTypes(Routable.Select(ass => KeyValuePair.Create(ass, ass)).ToList(), "Routable")
            }

            @if (CatchAll?.Count > 0)
            {
                @RenderSelectTypes(CatchAll, "Catch All")
            }

            @if (Roots?.Count > 0 || AllRoutes?.Count > 0)
            {
                @RenderSelectTypes((Roots ?? []).Concat((AllRoutes ?? []).Except(Roots ?? [])), "Root Component")
            }

        };


    public static RenderFragment RenderSelectTypes(IEnumerable<KeyValuePair<string, string>>? selectTypes, string? label)
        => __builder =>
        {
            <tr class="plugin-controls">
                <td colspan="3">
                    <span>@label</span><br />
                    <select onchange="">
                        <option value="">No @label</option>
                        @foreach (var layoutType in selectTypes ?? [])
                        {
                            <option value="@layoutType.Key">@(layoutType.Value)</option>
                        }
                    </select>
                </td>
            </tr>
        };

        

    public static bool GetActive(
        Dictionary<string, Assembly>? LoadedAssemblies,
        Dictionary<string, bool>? EnabledAssemblies, 
        string? title)
    {
        if (title == null) return false;
        if (EnabledAssemblies?.ContainsKey(title) == true)
            return true;
        if (LoadedAssemblies?.ContainsKey(title) == true)
            return true;
#if !BROWSER
        // TODO: use ISettings
        if (Microsoft.Maui.Storage.Preferences.Default.Get("PluginEnabled" + title, false))
            return true;
#endif
        return false;
    }

    public static async Task<string?> OnEnabled(
        TrustedLoader? Trust,
        TrustedState? State,
        string? title,
        bool? isChecked)
    {
        if (title == null) return null;

        if (isChecked != true)
            Trust?.Disable(title);
        else
            Trust?.Enable(title);


        Trust?.OnSettledAsync += OnSettled;

        return State?.Error;
    }

        
    public static (Assembly? Assembly, string? RoutableType) TryGetRoots(TrustedState? Trust)
    {
        var likelyRootAss = Trust?.Routable
            .FirstOrDefault(ass => Trust?.EnabledAssemblies.ContainsKey(ass.ToName()) == true)
            ?? Trust?.Routable.FirstOrDefault();

        var likelyRoute = Trust?.Roots[0].AssemblyQualifiedName
            ?? Trust?.AllRoutes.FirstOrDefault(t => t.Assembly == likelyRootAss)?.AssemblyQualifiedName
            ?? Trust?.AllRoutes[0].AssemblyQualifiedName;

        return (Assembly: likelyRootAss, RoutableType: likelyRoute);
    }



}
