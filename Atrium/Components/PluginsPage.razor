@page "/plugins"
@implements IAsyncRender
@implements IHasForms
@implements IHasCover
@attribute [Display(Name = "System Components", ShortName = "Plugins", GroupName = "Administration", Prompt = "bi-puzzle-fill")]

@code {



    public static (Assembly? Assembly, string? RoutableType) TryGetRoots(TrustedLoader? Trust)
    {
        var likelyRootAss = TrustedLoader.Routable
            .FirstOrDefault(ass => Trust?.EnabledAssemblies.ContainsKey(ass.ToName()) == true)
            ?? TrustedLoader.Routable.FirstOrDefault();

        var likelyRoute = TrustedLoader.Roots[0].AssemblyQualifiedName
            ?? TrustedLoader.AllRoutes.FirstOrDefault(t => t.Assembly == likelyRootAss)?.AssemblyQualifiedName
            ?? TrustedLoader.AllRoutes[0].AssemblyQualifiedName;

        return (Assembly: likelyRootAss, RoutableType: likelyRoute);
    }




    protected static async Task RenderAssemblyScannedFile(string? file, TrustedState? gatherTrust, ICompositeProvider? Composite, bool wait = true)
    {
        // 1. Immediate Throttled UI Update (Max every 200ms)
        // This keeps the UX fluid without flooding the RenderTree
        if (gatherTrust == null) return;
        if (!wait 
            || gatherTrust.LastUpdate == null 
            || (DateTime.Now - gatherTrust.LastUpdate.Value).TotalMilliseconds > 200)
        {
            gatherTrust.Scanning = file;
            gatherTrust.LastUpdate = DateTime.Now;
            gatherTrust.ScanningRendered = await RenderPluginStatus(
                gatherTrust.IsBootstrapping, 
                gatherTrust.Error, 
                gatherTrust.Scanning).ToHtml(Composite);
            gatherTrust.PluginSelect = await RenderPluginSelect(
                gatherTrust.Layouts,
                gatherTrust.Routable,
                gatherTrust.CatchAll,
                gatherTrust.Roots,
                gatherTrust.AllRoutes).ToHtml(Composite);
            gatherTrust.PreviousRendered = await RenderPluginList(
                Composite, gatherTrust, gatherTrust.MyList).ToHtml(Composite);

            var Page = Composite?.GetService<PageManager>();
            if (Page == null) return;
            if (Composite?.GetService<Components.MainLoader>()?.MainContent == null) return;
            await Page.Replace(".plugin-status, .plugin-controls", gatherTrust.ScanningRendered + gatherTrust.PluginSelect);
            await Page.Insert("#plugins-list > tbody", gatherTrust?.PreviousRendered);
        }
    }



    protected static RenderFragment RenderPluginList(
        ICompositeProvider? Composite,
        TrustedState? gatherTrust,
        IEnumerable<PluginContract>? MyList
    ) => __builder =>
    {
        if (gatherTrust == null) return;

        foreach (var plugin in MyList ?? gatherTrust.MyList ?? [])
        {
            List<string>? requiredBy = null;
            gatherTrust.Depended?.TryGetValue(plugin.Title, out requiredBy);
            RenderPluginContract(plugin, requiredBy, GetActive(Composite, plugin.Title))(__builder);
        }
    };


    public partial class TrustedState : IDisposable
    {
        // TODO: make json compatible by using the based types needed for output
        [JsonIgnore]
        public TrustedLoader? Trust { get; set; }
        public Dictionary<string, string>? Layouts { get; set; }
        public List<string>? Routable { get; set; }
        public Dictionary<string, string>? CatchAll { get; set; }
        public Dictionary<string, string>? Roots { get; set; }
        public Dictionary<string, string>? AllRoutes { get; set; }
        public bool? IsBootstrapping { get; set; }
        public string? Error { get; set; }
        public string? PreviousRendered { get; set; }
        public List<PluginContract>? MyList { get; set; }
        public DateTime? LastUpdate { get; set; }
        public string? Scanning { get; set; }
        public string? ScanningRendered { get; set; }
        public string? PluginSelect { get; set; }
        public Action<PluginContract?>? NotifyDelegate = null;
        public Dictionary<string, List<string>>? Depended { get; set; }
        public TrustedState(TrustedLoader? _trust)
        {
            Trust = _trust;
        }
        public void Dispose()
        {
            Trust?.OnAssemblyLoaded -= this.NotifyDelegate;
        }
    }



    public static TrustedState? GatherTrust(ICompositeProvider? Composite, TrustedState? GatheredTrust, TrustedLoader? Trust)
    {
        Trust ??= Composite?.GetService<TrustedLoader>();

        if (GatheredTrust == null)
        {
            GatheredTrust = new TrustedState(Trust);
            // this is a fancy service injector that i would have expected from microsoft dumbass compiler rewriting factory
            //  event handlers in javascript, wtf? Expression.ToString()? ever going to make that work like IQueryable?
            Composite?.GetService<IHasEvents>()?.Subscribe(PageAction.TogglePlugin, PluginsPage.OnEnabled);
        }

        GatheredTrust?.Layouts = TrustedLoader.Layouts.ToDictionary(t => t.AssemblyQualifiedName ?? t.FullName ?? t.Name, t => t.Name);
        GatheredTrust?.Routable = TrustedLoader.Routable.Select(ass => ass.ToName()).ToList();
        GatheredTrust?.CatchAll = TrustedLoader.CatchAll.ToDictionary(t => t.AssemblyQualifiedName ?? t.FullName ?? t.Name, t => t.Name);
        GatheredTrust?.Roots = TrustedLoader.Roots.ToDictionary(t => t.AssemblyQualifiedName ?? t.FullName ?? t.Name, t => t.Name);
        GatheredTrust?.AllRoutes = TrustedLoader.AllRoutes.ToDictionary(t => t.AssemblyQualifiedName ?? t.FullName ?? t.Name, t => t.Name);
        GatheredTrust?.IsBootstrapping = TrustedLoader.IsBootstrapping;
        GatheredTrust?.Error = TrustedLoader.Error;
        GatheredTrust?.MyList = Trust?.DiscoveredStatus.Values.OrderBy(p => p.Title).ToList();
        GatheredTrust?.Depended = Trust?.DependedAssemblies.ToDictionary();
        if (GatheredTrust?.NotifyDelegate == null)
        {
            GatheredTrust?.NotifyDelegate ??= async (PluginContract? file) =>
                {
                    await RenderAssemblyScannedFile(file?.InstallPath, GatheredTrust, Composite);
                };

            Trust?.OnAssemblyLoaded += GatheredTrust?.NotifyDelegate;
        }

        return GatheredTrust;
    }


    public static async Task OnSettled(ICompositeProvider? Composite)
    {
        var Trust = Composite?.GetService<TrustedLoader>();
        Trust?.OnSettledAsync += () => OnSettled(Composite);

        GatherTrust(Composite, GatheredTrust, Trust);
        if (GatheredTrust == null) return;

        await RenderAssemblyScannedFile("", GatheredTrust, Composite, false /*no wait*/);

        // in case something loaded not from use input/page event
        TriggerExpand(Composite);
    }


    public static TrustedState? GatheredTrust = null;

    public async Task<Delegate?> Render(
        ICompositeProvider? Composite
    )
    {
        var Trust = Composite?.GetService<TrustedLoader>();
        var Logo = Composite?.GetService<IHasClass>();
        // prevent concurrency errors while printing the view
        GatheredTrust = GatherTrust(Composite, GatheredTrust, Trust);
        Trust?.OnSettledAsync += () => OnSettled(Composite);

        if (GatheredTrust == null) return null;

        if (GatheredTrust.ScanningRendered == null)
            await RenderAssemblyScannedFile("", GatheredTrust, Composite);

        if (GatheredTrust.PluginSelect == null)
            await OnSettled(Composite);

        return RenderMainBody(Logo, GatheredTrust);
    }


    public static RenderFragment RenderMainBody(IHasClass? Logo, TrustedState? State)
        => __builder =>
        {

            <article class="content course-container">

                @*@Logo?.LogoContent*@

                <table id="plugins-list">
                    <tbody>

                        @(new MarkupString(State?.ScanningRendered ?? string.Empty))

                        @(new MarkupString(State?.PluginSelect ?? string.Empty))

                        @(new MarkupString(State?.PreviousRendered ?? string.Empty))

                    </tbody>
                </table>

            </article>

        };



    public static RenderFragment RenderPluginContract(PluginContract? plugin, List<string>? requiredBy, bool? Checked)
        => __builder =>
        {
            <tr data-id="@plugin?.Title">
                <td class="name-col">
                    <strong>@plugin?.Title</strong><br />
                    <span class="product-tag">@plugin?.Metadata.Product</span>
                </td>

                <td class="meta-col">
                    <small>Pkg: @plugin?.Metadata.Package</small><br />
                    <small>Pub: @plugin?.Metadata.Company @plugin?.Metadata.Publisher</small>
                </td>

                <td class="enable-col">
                    @if (requiredBy != null && requiredBy.Count > 0)
                    {
                        <label class="switch" aria-disabled="true">
                            <input type="checkbox" disabled="disabled" checked="checked" />
                        </label>
                        <span>Required By:</span><br />
                        @foreach (var required in requiredBy)
                        {
                            <span>@required</span><br />
                        }
                    }
                    else
                    {
                        <label class="switch">
                            <input type="checkbox" onchange="window.Atrium.Services.PageManager.TriggerEvent('TogglePlugin', ['@plugin?.Title', !!this.value])" checked="@Checked" />
                        </label>
                    }
                </td>
            </tr>
        };



    public static RenderFragment RenderPluginStatus(bool? IsBootstrapping, string? Error, string? Scanning)
    {
        var message = Error != null
            ? Error 
            : IsBootstrapping == true 
            ? ("Scanning plugins... " + Scanning) 
            : "Ready";

       return __builder =>
       {
           <tr class="plugin-status">
               <td colspan="3" class="status-container">
                   <button class="cta">Save and Continue</button><br />
                   <span class="box-status">
                       @message
                   </span>
               </td>
           </tr>
       };
    }


    public static RenderFragment RenderPluginSelect(
        Dictionary<string, string>? Layouts, 
        List<string>? Routable,
        Dictionary<string, string>? CatchAll,
        Dictionary<string, string>? Roots,
        Dictionary<string, string>? AllRoutes)
        => __builder =>
        {

            @if (Layouts?.Count > 0)
            {
                @RenderSelectTypes(Layouts, "Layout")
            }

            @if (Routable?.Count > 0)
            {
                @RenderSelectTypes(Routable.Select(ass => KeyValuePair.Create(ass, ass)).ToList(), "Routable")
            }

            @if (CatchAll?.Count > 0)
            {
                @RenderSelectTypes(CatchAll, "Catch All")
            }

            @if (Roots?.Count > 0 || AllRoutes?.Count > 0)
            {
                @RenderSelectTypes((Roots ?? []).Concat((AllRoutes ?? []).Except(Roots ?? [])), "Root Component")
            }

        };


    public static RenderFragment RenderSelectTypes(IEnumerable<KeyValuePair<string, string>>? selectTypes, string? label)
        => __builder =>
        {
            <tr class="plugin-controls">
                <td colspan="3">
                    <span>@label</span><br />
                    <select onchange="">
                        <option value="">No @label</option>
                        @foreach (var layoutType in selectTypes ?? [])
                        {
                            <option value="@layoutType.Key">@(layoutType.Value)</option>
                        }
                    </select>
                </td>
            </tr>
        };

        

    public static bool GetActive(ICompositeProvider? Composite, string? title)
    {
        if (title == null) return false;
        var Trust = Composite?.GetService<TrustedLoader>();
        if (Trust?.EnabledAssemblies.ContainsKey(title) == true)
            return true;
        if (Trust?.LoadedAssemblies.ContainsKey(title) == true)
            return true;
#if !BROWSER
        // TODO: use ISettings
        if (Microsoft.Maui.Storage.Preferences.Default.Get("PluginEnabled" + title, false))
            return true;
#endif
        return false;
    }

    public static async Task<string?> OnEnabled(
        ICompositeProvider? Composite,
        TrustedLoader? Trust,
        string? title,
        bool? isChecked)
    {
        if (title == null) return null;

        if (isChecked != true)
            Trust?.Disable(title);
        else
            Trust?.Enable(title);

        Trust?.OnSettled += () => TriggerExpand(Composite);

        return TrustedLoader.Error;
    }


    protected static void TriggerExpand(ICompositeProvider? Composite)
    {

        if (Composite?.GetService<TrustedLoader>()?.EnabledAssemblies.Count == 0
            && TrustedLoader.SystemEnabledAssemblies.Count == 0)
            _ = Composite?.GetService<IWindowManager>()?.ExpandWindow(false);
        else
            _ = Composite?.GetService<IWindowManager>()?.ExpandWindow(true);
    }



}
