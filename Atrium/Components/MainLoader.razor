@implements IHasChildren
@inject ICompositeProvider Composite

@(new MarkupString(ChildContent ?? string.Empty))

@code
{
    
    public static Dictionary<string, string> Query(string uri)
    {
        // Use a simple split/regex to avoid heavy libraries
        var query = uri.TrimStart('?');
        var parameters = query.Split('&')
                              .Select(p => p.Split('='))
                              .ToDictionary(p => p[0], p => p.Length > 1 ? Uri.UnescapeDataString(p[1]) : "");

        return parameters;
    }

    public static RenderFragment RenderHeader(IHasClass? Css, IRenderState? Rendered)
         => (RenderTreeBuilder __builder) =>
        {
            foreach (var cssUrl in Css?.Registry ?? [])
            {
                <link rel="stylesheet" href="@cssUrl" />
            }

            foreach (var item in Rendered?.State ?? [])
            {
                <input type="hidden" name="state_@item.Key" value="@item.Value" />
            }

        };


    public static RenderFragment RenderDebugInvocationLogger()
        => (RenderTreeBuilder __builder) =>
        {
            <script>
                (function() {
                const originalInvoke = DotNet.invokeMethodAsync;
                DotNet.invokeMethodAsync = function(assemblyName, methodName, ...args) {
                console.log(`[JS Interop] Calling: ${methodName} in ${assemblyName}`, "Args:", args);
                return originalInvoke.apply(this, [assemblyName, methodName, ...args]);
                };
                })();
            </script>
        };


    public static RenderFragment RenderPluginCoverPage()
        => (RenderTreeBuilder __builder) =>
        {
            <div class="cover-container"></div>
            <main class="cover-page">
                @*TODO: make this a component that can inject itself into a settings page*@
                <Atrium.Components.PluginsPage />
            </main>
        };

    static System.Reflection.Assembly? StoredAppAssembly = null;
    public async Task SetAppAssembly(System.Reflection.Assembly? assembly)
    {
        StoredAppAssembly = assembly;
    }

    public static RenderFragment RenderMain(IHasClass? Css, IRenderState? Rendered, bool ShowPlugins)
        => (RenderTreeBuilder __builder) =>
        {
            @RenderHeader(Css, Rendered)
#if DEBUG
            @RenderDebugInvocationLogger()
#endif
            <div class="page @(string.Join(" ", Css?.ClassNames ?? []))">
                
                @if (ShowPlugins)
                {
                    @RenderPluginCoverPage()
                }

            </div>
        };


    public async Task HasChanged()
    {
        ChildContent = await RenderMain(null, null, FirstTimeLoad).ToHtml(Composite);
        await InvokeAsync(StateHasChanged);
    }

    public bool FirstTimeLoad = true;

    public string? ChildContent = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if(firstRender)
        {
            var showPlugins = FirstTimeLoad; // || DefaultLayout == null || StoredAppAssembly == null;
            ChildContent = await RenderMain(null, null, FirstTimeLoad).ToHtml(Composite);
            await InvokeAsync(StateHasChanged);
        }
    }

#if false
    @if (FirstTimeLoad || DefaultLayout == null || StoredAppAssembly == null)
    {
    }



    private RenderFragment CreatePermissionContent(RouteData routeData) => builder =>
    {
        if (PermissionType == null) throw new InvalidOperationException("CreatePermissionContent was called without auth setup");
        builder.OpenComponent(0, PermissionType);

        // Pass the standard parameters
        builder.AddAttribute(1, "RouteData", routeData);
        builder.AddAttribute(2, "NotAuthorizedLayout", DefaultLayout);
        builder.AddAttribute(3, "LoadingLayout", DefaultLayout);

        // Pass the nested content (RouteView and FocusOnNavigate)
        builder.AddAttribute(4, "ChildContent", (RenderFragment)((childBuilder) =>
        {
            childBuilder.OpenComponent<RouteView>(0);
            childBuilder.AddAttribute(1, "RouteData", routeData);
            childBuilder.AddAttribute(2, "DefaultLayout", DefaultLayout);
            childBuilder.CloseComponent();

            childBuilder.OpenComponent<FocusOnNavigate>(3);
            childBuilder.AddAttribute(4, "RouteData", routeData);
            childBuilder.AddAttribute(5, "Selector", "h1");
            childBuilder.CloseComponent();
        }));

        builder.CloseComponent();
    };
#endif

}