{

    public class MainContentState
    {

        public static int ServiceCount = 0;
        public int ServiceId { get; internal set; }

        public bool FirstTimeLoad { get; internal set; }  = true;
        public string? PluginContent { get; internal set; }  = null;
        public string? MainContent { get; internal set; }  = null;
