@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@implements IHasRender
@implements IDisposable
@implements IComponent
@implements IHasHeader
@inject ICompositeProvider Composite
@inject IServiceProvider Service
@inject IJSRuntime Runtime

@{
    ((RenderFragment)Render(Composite))(__builder);
}

@code
{
    protected Type? StoredDefaultRoot { get; set; } = null;
    protected string? Body { get; set; } = null;

    public static int ServiceCount = 0;
    public int ServiceId { get; }

    public MainLoader() : base()
    {
        // trying to debug something, and then it wouldn't increment 
        ServiceId = Interlocked.Increment(ref ServiceCount);
    }


    void IComponent.Attach(RenderHandle renderHandle)
    {
        var renderField = typeof(ComponentBase).GetField("_renderHandle", BindingFlags.Instance | BindingFlags.NonPublic);
        renderField?.SetValue(this, renderHandle);
    }



    public static Dictionary<string, string> Query(string uri)
    {
        // Use a simple split/regex to avoid heavy libraries
        var query = uri.TrimStart('?');
        var parameters = query.Split('&')
                              .Select(p => p.Split('='))
                              .ToDictionary(p => p[0], p => p.Length > 1 ? Uri.UnescapeDataString(p[1]) : "");

        return parameters;
    }


    public async Task RenderHeader(IHasClass? Classy)
    {
        var Form = Composite.GetService<IFormFactor>();
        // TODO: check if response started and update with method below
        var Page = Composite.GetService<PageManager>();
        if (Page == null) return;
        //IJSRuntime Runtime = Rendered?.Runtime as IJSRuntime;
        var Header = await MainLoader.RenderStaticHeader(Classy).ToHtml(Composite);
        await Page.Insert("link[data-id]", Header);
    }


    public static RenderFragment RenderStaticHeader(IHasClass? Css)
         => (RenderTreeBuilder __builder) =>
        {
            <link data-id="cover.css" rel="stylesheet" href="/css/cover.css" />
            @foreach (var cssUrl in Css?.Registry ?? [])
            {
                <link data-id="@cssUrl.Split('/').Last()" rel="stylesheet" href="@cssUrl" />
            }


        };



    public static RenderFragment RenderDebugInvocationLogger()
        => (RenderTreeBuilder __builder) =>
        {
            <script>
                (function() {
                const originalInvoke = DotNet.invokeMethodAsync;
                DotNet.invokeMethodAsync = function(assemblyName, methodName, ...args) {
                console.log(`[JS Interop] Calling: ${methodName} in ${assemblyName}`, "Args:", args);
                return originalInvoke.apply(this, [assemblyName, methodName, ...args]);
                };
                })();
            </script>
        };

    protected override void OnInitialized()
    {
        base.OnInitialized();

        Composite.GetService<IRenderState>()?.NotifyEmptied(Runtime);
        //Composite.GetService<TrustedLoader>()?.OnSettledAsync += TryRenderingDefault;
    }
    /*
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        //if(firstRender)
        await TryRenderingDefault();
}*/

    protected async Task TryRenderingDefault()
    {
        if (IsClosing == true) return;

        var Form = Composite.GetService<IFormFactor>();
        if (Form?.IsWebContext == true) return;

        var Trust = Composite.GetService<TrustedLoader>();
        Trust?.OnSettledAsync += TryRenderingDefault; // try again

        var Rendered = Composite.GetService<IRenderState>();
        if(Rendered?.IsReady != true)
            Rendered?.NotifyRendered(Runtime);

        if(MainContent == null)
        {
            await InitializeRender(Composite, Service, Runtime);
        }

        var Page = Composite?.GetService<PageManager>();
        if (Page == null) return;
        if (StoredDefaultRoot == null)
        {
            // TODO: make this a page event from plugins like RootReady so on normal startup its a streamlined process
            StoredDefaultRoot = Trust?.DefaultRoot();
            if (StoredDefaultRoot == null) return;
            var Classy = Composite?.GetService<IHasClass>();
            Classy?.SetRoute(StoredDefaultRoot);
            await RenderHeader(Classy);
            if (Composite?.GetService<ITitleService>() is ITitleService Title)
                await Title.SetDefaultTitle(StoredDefaultRoot);
            Body = await StoredDefaultRoot.ToHtml(Composite);
            await Page.Replace("#page > main:not(.cover-page) > article", Body);
        }
    }



    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await TryRenderingDefault();

    }


    public Delegate Render(ICompositeProvider? Composite)
    {
        Composite?.GetService<TrustedLoader>()?.OnSettledAsync += TryRenderingDefault;
        //var Form = Service?.GetService<IFormFactor>();
        //if(Form?.IsWebContext == true)
        //{
        //    var fragment = RenderStaticPageWrapper();
        //    return fragment;
        //}
        //else
        return RenderMain(Composite, Service);
    }


    protected static RenderFragment RenderMain(ICompositeProvider? Composite, IServiceProvider? Service)
        => (RenderTreeBuilder __builder) =>
        {
            var Css = Composite?.GetService<IHasClass>();
            var Rendered = Composite?.GetService<IRenderState>();
            var Main = Service?.GetService<MainLoader>();


            @RenderStaticHeader(Css)
            
            foreach (var item in Rendered?.State ?? [])
            {
                <input type="hidden" name="state_@item.Key" value="@item.Value" />
            }
#if DEBUG
            @RenderDebugInvocationLogger()
#endif


            <div id="page" class="page @(string.Join(" ", Css?.ClassNames ?? []))">

                @if (Main?.FirstTimeLoad == true)
                {
                    <div class="cover-container"></div>
                    <main class="cover-page">
                        @if (Main?.PluginContent != null)
                        {
                            @(new MarkupString(Main.PluginContent))
                        }
                        else
                        {
                            <article></article>
                        }

                    </main>
                }

                <main><article>
                    
                </article></main>

            </div>
        };


    public static async Task InitializeRender(ICompositeProvider? Composite, IServiceProvider? Service, IJSRuntime? Runtime)
    {
        if (Service == null || Composite == null) return;
        var Main = Service.GetService<MainLoader>();


        if (Composite.GetService<PluginsPage>() is PluginsPage Plugins
            && await Plugins.Render(Composite, Service) is RenderFragment Render)
        {
            var newContent = await Render.ToHtml(Composite);
            Main?.PluginContent = newContent;
        }
        
        var newMain = await RenderMain(Composite, Service).ToHtml(Composite);
        Main?.MainContent = newMain;

        var Page = Composite.GetService<PageManager>();
        if (Page == null) return;
        await Page.EnsureInitialized();
        await Page.Replace("#page", newMain);
        await Page.Replace("#page > .cover-page > article", Main?.PluginContent);

    }

    public bool FirstTimeLoad = true;
    public string? PluginContent = null;
    public string? MainContent = null;
    public bool? IsClosing = false;



    public void Dispose()
    {
        IsClosing = true;
        StoredDefaultRoot = null;
        var Plugins = Composite.GetService<PluginsPage>();
        Composite.GetService<IRenderState>()?.NotifyEmptied(Runtime);
        Composite.GetService<TrustedLoader>()?.OnSettledAsync -= TryRenderingDefault;
        GC.SuppressFinalize(this);
    }


