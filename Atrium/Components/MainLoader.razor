    public static Dictionary<string, string> Query(string uri)
    {
        // Use a simple split/regex to avoid heavy libraries
        var query = uri.TrimStart('?');
        var parameters = query.Split('&')
                              .Select(p => p.Split('='))
                              .ToDictionary(p => p[0], p => p.Length > 1 ? Uri.UnescapeDataString(p[1]) : "");

        return parameters;
    }


    public static void Insert(IWindow window, string id, string content) {
        try
        {
            var container = window.document.querySelector(id);
            var template = window.document.createElement("template");
            template.innerHTML = content;

            IArray<IElement> newNodes = (IArray<IElement>)window.Array.from(template.content.children.filter(n => n.nodeType == 1));
            IArray<IElement> existing = window.Array.from(container.children);

            IArray<IElement> combined = newNodes.concat(existing);

            combined.sort((a, b) => (a.getAttribute("data-id"))
                    .localeCompare(b.getAttribute("data-id")))
                    .forEach(node => container.appendChild(node));
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    public static void Replace(IWindow window, string selector, string content)
    {
        try
        {
            var nodesToRemove = window.document.querySelectorAll(selector);
            var template = window.document.createElement("template");

            // Direct assignment and fragment injection
            template.innerHTML = content;
            var fragment = window.document.createDocumentFragment();

            window.Array.from(template.content.children).forEach(node => fragment.appendChild(node));

            var firstNode = nodesToRemove[0];
            firstNode.parentNode?.insertBefore(fragment, firstNode);
            nodesToRemove.forEach(oldNode => oldNode.remove());
        }
        catch(Exception ex)
        {
            Console.WriteLine(ex);
        }
    }


    public static RenderFragment RenderHeader(IRenderState? State, IHasClass? Css)
    {
        RenderFragment Header = (RenderTreeBuilder __builder) =>
        {
            <link data-id="cover.css" rel="stylesheet" href="/css/cover.css" />
            @foreach (var cssUrl in Css?.Registry ?? [])
            {
                <link data-id="@cssUrl.Split('/').Last()" rel="stylesheet" href="@cssUrl" />
            }
            
            foreach (var item in State?.State ?? [])
            {
                <input data-id="@item.Key" type="hidden" name="state_@item.Key" value="@item.Value" />
            }
        };
        App.Bridge?.InvokeAsync(async () => Insert(App.Bridge.window, "link[data-id], input[type='hidden'][data-id]", await Header.ToHtml()));
        return Header;
    }



