@page "/hosting"
@implements IDisposable
@implements IHasForms
@implements IHasRender
@implements IHasStaticRender
@attribute [Display(Name = "Hosting", GroupName = "Administration", Prompt = "bi-hdd-network")]

@code
{
    [Inject] public ICompositeProvider? Composite { get; set; }


    public Delegate Render(ICompositeProvider? Composite)
    => RenderStaticMain(Composite);


    public static Delegate RenderStatic(ICompositeProvider? Composite)
         => RenderStaticMain(Composite);


    public static RenderFragment RenderStaticMain(ICompositeProvider? Composite)
        => __builder =>
        {
            var Hosting = Composite?.GetService<Pages.Hosting>();
            if(Hosting != null)
            {
                // try to make the first one hit AFTER the dll to run it has loaded
                // this also runs the first time
                Composite?.GetService<ITrustProvider>()?.OnSettledAsync += Hosting.PollTunnelStatusAsync;
                if (_timer == null)
                    _timer = TaskExtensions.Timer(Hosting.PollTunnelStatusAsync, 60 * 3 * 1000);
            }
            var Page = Composite?.GetService<IHasEvents>();
            Page?.Subscribe(PageAction.ToggleHosting, EnableHosting);
            var Status = Composite?.GetService<IHostingService>();
            var Window = Composite?.GetService<IWindowManager>();
            Parallel.ForEachAsync(new List<Task?> {
                Status?.CheckInstalled().Then(yes => Installed = yes),
                Window?.CheckInstalled().Then(yes => StartupTray = yes)
                }, async (task, _) => {
                    if (task != null)
                        await task;
                }).Then(async () => {
                    if(Hosting != null)
                        await Hosting.ReplaceSettings(Composite);
                });


             @RenderSettings()

             @RenderInstructions()

             @RenderStatusHeader()
             
             @RenderStatus()
        };


    public static RenderFragment RenderStatusHeader()
        => __builder =>
        {

            <heading class="flex-row">
                <label></label>
                <label>Service</label>
                <label>Status</label>
                <label>Last Checked</label>
                <label>Actions</label>
            </heading>
        };


    protected async Task ReplaceSettings(ICompositeProvider? Composite)
    {
        Composite?.GetService<IHasInterconnect>()?.Replace("page.hosting .form-row", await RenderSettings().ToHtml(Composite));
    }


    // this is better as a static because then i can make it an interface and call it from 
    //   a general "settings" page, or make a mock __builder that discards everything but form-row 
    //   and builds my console boxes
    public static RenderFragment RenderSettings()
         => __builder =>
         {
             <div class="form-row">
                 <label>Enable HTTP hosting</label>
                 <input type="checkbox" @bind="@IsServicing" onchange="window.Atrium.Services.PageManager.TriggerEvent('ToggleHosting', !!this.value)" />
             </div>

             <div class="form-row">
                 <label>Enable as a Windows Service</label>
                 <input type="checkbox" @bind="@Installed" onchange="window.Atrium.Services.PageManager.TriggerEvent('ToggleService', !!this.value)" />
             </div>

             <div class="form-row">
                 <label>Run this application in the tray after Windows boots</label>
                 <input type="checkbox" @bind="@StartupTray" onchange="window.Atrium.Services.PageManager.TriggerEvent('ToggleStartup', !!this.value)" />
             </div>

         };


    // all better as static so i can call it from the status page and put all the plugin statuses in one place
    //   maybe less detailed instruction wise, maybe i insert those too...

    public static RenderFragment RenderStatus()
    => __builder =>
    {
        
        <div class="flex-row">
            <span></span>
            <span>Cloud Flare Service</span>
            <span>@serviceStatus</span>
            <span>@serviceChecked</span>
            <span><span class="bi @(IsServicing == true ? "bi-check-circle" : IsServicing == false ? "bi-x-circle" : "bi-clock")"></span></span>
        </div>
        <div class="flex-row">
            <span></span>
            <span>Cloud Flare Api</span>
            <span>@tunnelStatus</span>
            <span>@lastChecked</span>
            <span><span class="bi @(IsTunneling == true ? "bi-check-circle" : IsTunneling == false ? "bi-x-circle" : "bi-clock")"></span></span>
        </div>
        <div class="flex-row">
            <span></span>
            <span>Atrium</span>
            <span>
                @hostStatus
                @if (IsWorking == true)
                {
                    <span> site is <a href="https://@(_domain)/">live and accessible.</a></span>
                }
            </span>
            <span>@hostChecked</span>
            <span><span class="bi @(IsWorking == true ? "bi-check-circle" : IsWorking == false ? "bi-x-circle" : "bi-clock")"></span></span>
        </div>

    };



    public static RenderFragment RenderInstructions()
     => __builder =>
     {
         <AccordionSection IsExpanded="IsWorking != true" Title="Become A Host">
             <p>The easiest pipeline to monitored hosting is to enable the Atrium web service.</p>
             <p>Then use cloud-flared reverse tunnel to secure your domain past any firewall restrictions.</p>
             <p>Disclaimer - This requires administrator privileges, so probably don't try it at work.</p>
         </AccordionSection>

         <AccordionSection IsExpanded="IsWorking != true" Title="Install Prerequisites">
             <a href="https://github.com/cloudflare/cloudflared/releases">Cloud Flared download page</a>
             <h3>Create a tunnel</h3>
             <a href="https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/get-started/create-remote-tunnel/">Set up a tunnel</a>
             <h3>Create a read all token</h3>
             <a href="https://developers.cloudflare.com/fundamentals/api/get-started/create-token/">Create token instructions</a>
             <h3>Install Atrium service</h3>
             @if (!OperatingSystem.IsWindows())
             {
                 <p>Click here to run Atrium service install</p>
             }
             else
             {
                 <p>Run Atrium desktop to use your own hosted service</p>
             }
         </AccordionSection>

         <AccordionSection IsExpanded="IsWorking != true" Title="Account Settings">
             <label>Tunnel Name</label>
             <input @bind="TunnelName" type="text" />

             <label>API Token</label>
             <input @bind="ApiToken" type="password" />

             <label>Account ID</label>
             <input @bind="AccountId" type="text" />

             <label>Domain Name</label>
             <input @bind="Domain" type="text" />
         </AccordionSection>

     };



    protected static async Task EnableHosting(ICompositeProvider Composite, bool enable)
    {
        if(enable)
        {
            if (Composite.GetService<WebServer>() is WebServer server && !WebServer.IsStarting)
                await server.EnsureInitialized();
#if WINDOWS
            else if (Composite.GetService<Lazy<Microsoft.AspNetCore.Builder.WebApplication?>>()?.Value == null)
                WebServer.StartWebServer(Composite?.GetService<ITrustProvider>());
#endif
        }
        else
        {
            // TODO: connect to real server with page event event from browser
#if WINDOWS
            if (WebServer.Current != null)
                await WebServer.Current.StopAsync();
#endif
        }
    }

    protected void EnableService(ChangeEventArgs args)
    {

    }

    protected async Task EnableStartup(ChangeEventArgs args)
    {
#if WINDOWS
        var Window = Composite.GetService<IWindowManager>();
        //if (Window?.IsSplashMode == true)
        {
            if(Window?.CreateTrayIcon() is Task task) await task;
        }
#endif

    }


    public Hosting(ICompositeProvider? _composite)
    {
        Composite ??= _composite;
    }
    
    public Hosting()
    {
    }


    private static string? _apiToken;
    private string? ApiToken
    {
        get => _apiToken;
        set
        {
            _apiToken = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }
    private static string? _tunnelName;
    private string? TunnelName
    {
        get => _tunnelName;
        set
        {
            _tunnelName = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }
    private static string? _accountId;
    private string? AccountId
    {
        get => _accountId;
        set
        {
            _accountId = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }
    private static string? _domain;
    private string? Domain
    {
        get => _domain ?? Composite?.GetService<IHostingService>()?.GetHost() ?? Composite?.GetService<HttpClient>()?.BaseAddress?.Authority;
        set
        {
            _domain = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }

    private static string? tunnelStatus = "Checking Cloud Flare...";
    private static string lastChecked = "Never";
    private static string? hostStatus = "Checking Public Access...";
    private static string hostChecked = "Never";
    private static string? serviceStatus = "Checking Services...";
    private static string serviceChecked = "Never";
    private static CancellationTokenSource? _timer;
    private static bool? IsWorking { get; set; } = null;
    private static bool? IsTunneling { get; set; } = null;
    private static bool? IsServicing { get; set; } = null;
    private static bool? Installed { get; set; } = null;
    private static bool? StartupTray { get; set; } = null;

    private async Task PollTunnelStatusAsync()
    {
        if(_timer == null)
        {
            _timer = TaskExtensions.Timer(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
        await CheckStatus(Composite, new HostingSettings
        {
            AccountId = AccountId,
            TunnelName = TunnelName,
            ApiToken = ApiToken,
            Domain = Domain
        });
    }


    public void Dispose()
    {
        _timer?.Cancel();
        _timer = null;
    }


    public static async Task CheckStatus(ICompositeProvider? Composite, HostingSettings? Settings)
    {
        try
        {
            var StatusService = Composite?.GetService<IHostingService>();
            if(StatusService == null)
            {
                return;
            }

            // TODO: needs to be Http>async  Domain default, callback to our own server, then below callback to public server
            var token = await StatusService.GetToken();
            var host = StatusService.GetHost();


            tunnelStatus = await StatusService.CheckTunnel(Settings?.AccountId, Settings?.TunnelName, Settings?.ApiToken);
            IsTunneling = tunnelStatus == "healthy";
            lastChecked = DateTime.Now.ToLongTimeString();


            IsServicing = Composite?.GetService<WebServer>()?.IsReady ?? await StatusService.CheckInstalled();
            serviceStatus = IsServicing == true ? "Service is installed" : "Service is not installed";
            serviceChecked = DateTime.Now.ToLongTimeString();

            if (string.IsNullOrWhiteSpace(Settings?.Domain))
            {
                Settings?.Domain = host;
            }

            if (string.IsNullOrWhiteSpace(Settings?.Domain))
            {
                hostStatus = "Domain name not set.";
                return;
            }

            var result = await StatusService.CheckRemoteStatus(Settings?.Domain);

            if (token != null && result?.Error == null && result?.ItWorks?[0] == token)
            {
                hostStatus = $"Tokens match, ";
                IsWorking = true;
            } else
            {
                hostStatus = "Error: " + result?.Error;
                hostStatus = "Token mismatch, site is not accessible.";
            }
            hostChecked = DateTime.Now.ToLongTimeString();

            // Required to tell Blazor the data changed outside of a UI event
            Composite?.GetService<IHasEvents>()?.TriggerEvent("HostingStatus", IsWorking);
        }
        catch (System.Text.Json.JsonException ex)
        {
            hostStatus = "Response parse error: " + ex.Message;
        }
        catch (Exception ex)
        {
            hostStatus = "Error: " + ex.Message;
        }
    }
}