@page "/hosting"
@using System.Text.Json.Serialization
@implements IHasForms
@attribute [Display(Name = "Hosting", GroupName = "Administration", Prompt = "bi-hdd-network")]

@code
{
    public class HostingStatus
    {
        internal string? _apiToken { get; set; }
        internal string? _tunnelName { get; set; }
        internal string? _accountId { get; set; }
        internal string? _domain { get; set; }
        public string? tunnelStatus { get; internal set; } = "Checking Cloud Flare...";
        public string lastChecked { get; internal set; } = "Never";
        public string? hostStatus { get; internal set; } = "Checking Public Access...";
        public string hostChecked { get; internal set; } = "Never";
        public string? serviceStatus { get; internal set; } = "Checking Services...";
        public string serviceChecked { get; internal set; } = "Never";
        [JsonIgnore]
        public CancellationTokenSource? _timer { get; internal set; } = null;
        public bool? IsWorking { get; internal set; } = null;
        public bool? IsTunneling { get; internal set; } = null;
        public bool? IsServicing { get; internal set; } = null;
        public bool? Installed { get; internal set; } = null;
        public bool? StartupTray { get; internal set; } = null;

    }

    public static HostingStatus CurrentStatus { get; } = new();


    public static RenderFragment RenderStaticMain(ICompositeProvider? Composite)
        => __builder =>
        {
            var Hosting = Composite?.GetService<Pages.Hosting>();
            if(Hosting != null)
            {
                // try to make the first one hit AFTER the dll to run it has loaded
                // this also runs the first time
                Composite?.GetService<ITrustProvider>()?.OnSettledAsync += Hosting.PollTunnelStatusAsync;
                if (CurrentStatus._timer == null)
                    CurrentStatus._timer = TaskExtensions.Timer(Hosting.PollTunnelStatusAsync, 60 * 3 * 1000);
            }
            var Page = Composite?.GetService<IHasEvents>();
            Page?.Subscribe(PageAction.ToggleHosting, EnableHosting);
            var Status = Composite?.GetService<IHostingService>();
            var Window = Composite?.GetService<IWindowManager>();
            Parallel.ForEachAsync(new List<Task?> {
                Status?.CheckInstalled().Then(yes => CurrentStatus.Installed = yes),
                Window?.CheckInstalled().Then(yes => CurrentStatus.StartupTray = yes)
                }, async (task, _) => {
                    if (task != null)
                        await task;
                }).Then(async () => {
                    if(Hosting != null)
                        Composite?.GetService<IHasInterconnect>()?.Replace("page.hosting .form-row", await RenderSettings().ToHtml(Composite));
                });

            <article>
                @RenderSettings()

                @RenderInstructions()

                @RenderStatusHeader()
             
                @RenderStatus()
            </article>
        };


    public static RenderFragment RenderStatusHeader()
        => __builder =>
        {

            <heading class="flex-row">
                <label></label>
                <label>Service</label>
                <label>Status</label>
                <label>Last Checked</label>
                <label>Actions</label>
            </heading>
        };




    // this is better as a static because then i can make it an interface and call it from 
    //   a general "settings" page, or make a mock __builder that discards everything but form-row 
    //   and builds my console boxes
    public static RenderFragment RenderSettings()
         => __builder =>
         {
             <div class="form-row">
                 <label>Enable HTTP hosting</label>
                 <input type="checkbox" @bind="@CurrentStatus.IsServicing" onchange="window.Atrium.Services.PageManager.TriggerEvent('ToggleHosting', !!this.value)" />
             </div>

             <div class="form-row">
                 <label>Enable as a Windows Service</label>
                 <input type="checkbox" @bind="@CurrentStatus.Installed" onchange="window.Atrium.Services.PageManager.TriggerEvent('ToggleService', !!this.value)" />
             </div>

             <div class="form-row">
                 <label>Run this application in the tray after Windows boots</label>
                 <input type="checkbox" @bind="@CurrentStatus.StartupTray" onchange="window.Atrium.Services.PageManager.TriggerEvent('ToggleStartup', !!this.value)" />
             </div>

         };


    // all better as static so i can call it from the status page and put all the plugin statuses in one place
    //   maybe less detailed instruction wise, maybe i insert those too...

    public static RenderFragment RenderStatus()
    => __builder =>
    {
        
        <div class="flex-row">
            <span></span>
            <span>Cloud Flare Service</span>
            <span>@CurrentStatus.serviceStatus</span>
            <span>@CurrentStatus.serviceChecked</span>
            <span><span class="bi @(CurrentStatus.IsServicing == true ? "bi-check-circle" : CurrentStatus.IsServicing == false ? "bi-x-circle" : "bi-clock")"></span></span>
        </div>
        <div class="flex-row">
            <span></span>
            <span>Cloud Flare Api</span>
            <span>@CurrentStatus.tunnelStatus</span>
            <span>@CurrentStatus.lastChecked</span>
            <span><span class="bi @(CurrentStatus.IsTunneling == true ? "bi-check-circle" : CurrentStatus.IsTunneling == false ? "bi-x-circle" : "bi-clock")"></span></span>
        </div>
        <div class="flex-row">
            <span></span>
            <span>Atrium</span>
            <span>
                @CurrentStatus.hostStatus
                @if (CurrentStatus.IsWorking == true)
                {
                    <span> site is <a href="https://@(CurrentStatus._domain)/">live and accessible.</a></span>
                }
            </span>
            <span>@CurrentStatus.hostChecked</span>
            <span><span class="bi @(CurrentStatus.IsWorking == true ? "bi-check-circle" : CurrentStatus.IsWorking == false ? "bi-x-circle" : "bi-clock")"></span></span>
        </div>

    };



    public static RenderFragment RenderInstructions()
     => __builder =>
     {
         <AccordionSection IsExpanded="CurrentStatus.IsWorking != true" Title="Become A Host">
             <p>The easiest pipeline to monitored hosting is to enable the Atrium web service.</p>
             <p>Then use cloud-flared reverse tunnel to secure your domain past any firewall restrictions.</p>
             <p>Disclaimer - This requires administrator privileges, so probably don't try it at work.</p>
         </AccordionSection>

         <AccordionSection IsExpanded="CurrentStatus.IsWorking != true" Title="Install Prerequisites">
             <a href="https://github.com/cloudflare/cloudflared/releases">Cloud Flared download page</a>
             <h3>Create a tunnel</h3>
             <a href="https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/get-started/create-remote-tunnel/">Set up a tunnel</a>
             <h3>Create a read all token</h3>
             <a href="https://developers.cloudflare.com/fundamentals/api/get-started/create-token/">Create token instructions</a>
             <h3>Install Atrium service</h3>
             @if (!OperatingSystem.IsWindows())
             {
                 <p>Click here to run Atrium service install</p>
             }
             else
             {
                 <p>Run Atrium desktop to use your own hosted service</p>
             }
         </AccordionSection>

         <AccordionSection IsExpanded="CurrentStatus.IsWorking != true" Title="Account Settings">
             <label>Tunnel Name</label>
             <input @bind="TunnelName" type="text" />

             <label>API Token</label>
             <input @bind="ApiToken" type="password" />

             <label>Account ID</label>
             <input @bind="AccountId" type="text" />

             <label>Domain Name</label>
             <input @bind="Domain" type="text" />
         </AccordionSection>

     };



    protected static async Task EnableHosting(ICompositeProvider Composite, bool enable)
    {
        if(enable)
        {
            if (Composite.GetService<WebServer>() is WebServer server && !WebServer.IsStarting)
                await server.EnsureInitialized();
#if WINDOWS
            else if (Composite.GetService<Lazy<Microsoft.AspNetCore.Builder.WebApplication?>>()?.Value == null)
                WebServer.StartWebServer(Composite?.GetService<ITrustProvider>());
#endif
        }
        else
        {
            // TODO: connect to real server with page event event from browser
#if WINDOWS
            if (WebServer.Current != null)
                await WebServer.Current.StopAsync();
#endif
        }
    }

    protected static void EnableService(ChangeEventArgs args)
    {

    }

    protected static async Task EnableStartup(ChangeEventArgs args)
    {
#if WINDOWS
        var Window = Composite.GetService<IWindowManager>();
        //if (Window?.IsSplashMode == true)
        {
            if(Window?.CreateTrayIcon() is Task task) await task;
        }
#endif

    }

    private string? ApiToken
    {
        get => CurrentStatus._apiToken;
        set
        {
            CurrentStatus._apiToken = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }


    private string? TunnelName
    {
        get => CurrentStatus._tunnelName;
        set
        {
            CurrentStatus._tunnelName = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }

    private string? AccountId
    {
        get => CurrentStatus._accountId;
        set
        {
            CurrentStatus._accountId = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }

    private string? Domain
    {
        get => CurrentStatus._domain;
        set
        {
            CurrentStatus._domain = value;
            _ = TaskExtensions.Debounce(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
    }


    protected ICompositeProvider Composite;

    public Hosting(ICompositeProvider composite)
    {
        Composite = composite;
    }


    private async Task PollTunnelStatusAsync()
    {
        if (CurrentStatus._timer == null)
        {
            CurrentStatus._timer = TaskExtensions.Timer(PollTunnelStatusAsync, 60 * 3 * 1000);
        }
        await CheckStatus(Composite, new HostingSettings
        {
            AccountId = AccountId,
            TunnelName = TunnelName,
            ApiToken = ApiToken,
            Domain = Domain
        });
    }


    public static async Task CheckStatus(ICompositeProvider? Composite, HostingSettings? Settings)
    {
        try
        {
            var StatusService = Composite?.GetService<IHostingService>();
            if(StatusService == null)
            {
                return;
            }

            // TODO: needs to be Http>async  Domain default, callback to our own server, then below callback to public server
            var token = await StatusService.GetToken();
            var host = StatusService.GetHost();


            CurrentStatus.tunnelStatus = await StatusService.CheckTunnel(Settings?.AccountId, Settings?.TunnelName, Settings?.ApiToken);
            CurrentStatus.IsTunneling = CurrentStatus.tunnelStatus == "healthy";
            CurrentStatus.lastChecked = DateTime.Now.ToLongTimeString();


            CurrentStatus.IsServicing = Composite?.GetService<WebServer>()?.IsReady ?? await StatusService.CheckInstalled();
            CurrentStatus.serviceStatus = CurrentStatus.IsServicing == true ? "Service is installed" : "Service is not installed";
            CurrentStatus.serviceChecked = DateTime.Now.ToLongTimeString();

            if (string.IsNullOrWhiteSpace(Settings?.Domain))
            {
                Settings?.Domain = host;
            }

            if (string.IsNullOrWhiteSpace(Settings?.Domain))
            {
                CurrentStatus.hostStatus = "Domain name not set.";
                return;
            }

            var result = await StatusService.CheckRemoteStatus(Settings?.Domain);

            if (token != null && result?.Error == null && result?.ItWorks?[0] == token)
            {
                CurrentStatus.hostStatus = $"Tokens match, ";
                CurrentStatus.IsWorking = true;
            } else
            {
                CurrentStatus.hostStatus = "Error: " + result?.Error;
                CurrentStatus.hostStatus = "Token mismatch, site is not accessible.";
            }
            CurrentStatus.hostChecked = DateTime.Now.ToLongTimeString();

            // Required to tell Blazor the data changed outside of a UI event
            Composite?.GetService<IHasEvents>()?.TriggerEvent("HostingStatus", CurrentStatus.IsWorking);
        }
        catch (System.Text.Json.JsonException ex)
        {
            CurrentStatus.hostStatus = "Response parse error: " + ex.Message;
        }
        catch (Exception ex)
        {
            CurrentStatus.hostStatus = "Error: " + ex.Message;
        }
    }
}