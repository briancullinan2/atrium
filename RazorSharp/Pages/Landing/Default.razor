@page "/"
@page "/index.html"
@page "/app.html"
@page "/{*notFound}"
@implements IHasRender

@code
{

    [Parameter] public string? notFound { get; set; }



    public static RenderFragment RenderDefaultRoute(ICompositeProvider? Composite, string? notFound)
        => __builder =>
        {
            var DefaultRoot = (Composite?.GetService<ITrustProvider>() as ITrustStatic)?.DefaultRoot();
            var Classy = Composite?.GetService<IHasClass>();
            var Header = Composite?.GetService<IHasHeader>();
            @if (DefaultRoot != null && DefaultRoot != typeof(Pages.Landing.Default))
            {
                Classy?.SetRoute(DefaultRoot);
                Header?.RenderHeader(Composite, Classy);
                __builder.OpenComponent(0, DefaultRoot);
                __builder.CloseComponent();
            }
            else if (!String.IsNullOrWhiteSpace(notFound))
            {
                <NotFoundControl />
            }
            else
            {
                <div class="flash-card animate-in">
                    TODO: Find a home page.
                </div>
            }

        };



    public Delegate Render(ICompositeProvider? Composite)
        => RenderDefaultRoute(Composite, notFound);

}