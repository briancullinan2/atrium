<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<TargetFrameworks>net10.0-browser</TargetFrameworks>
		<OutputType>Library</OutputType>
		<WasmBuildNative>true</WasmBuildNative>
		<HasRuntimeOutput>false</HasRuntimeOutput>
		<RootNamespace>DataStore</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Providers\DataTablesRequestModel.cs" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*-*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*-*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*-*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.*-*" />
		<PackageReference Include="Microsoft.JSInterop" Version="10.0.*-*" />
	</ItemGroup>
	
	<ItemGroup Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' != 'true'">
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.*-*" />
	</ItemGroup>

	<ItemGroup Condition="'$(UsingMicrosoftNETSdkBlazorWebAssembly)' == 'true'">
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.*-*" ExcludeAssets="all" />
		<PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="3.0.*-*" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\Extensions\Extensions.csproj" />
	</ItemGroup>

</Project>
