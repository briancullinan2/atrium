@using Extensions.PrometheusTypes
@using Interfacing.Services
@using RazorSharp.Controls
@using RazorSharp.Extensions
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using System.Text.Json
@using System.Text.Json.Serialization
@implements IDisposable
@inject NavigationManager Nav
@inject ICompositeProvider Composite
@inject IServiceProvider Service
@inject ITrustProvider Trust
@inject IHasClass Css

@foreach (var cssUrl in Css.Registry)
{
    <link rel="stylesheet" href="@cssUrl" />
}
@*TODO: using the layout injection found below that way it only happens if there is a state set *@
@foreach (var item in Rendered?.State ?? [])
{
    <input type="hidden" name="state_@item.Key" value="@item.Value" />
}

<div class="page @(Ready) @(string.Join(" ", Css.ClassNames))">
    <CascadingValue Name="Loader" Value="@this">
        <Router OnNavigateAsync="HandleNavigation" 
                AppAssembly="@StoredAppAssembly"
                AdditionalAssemblies="@EntryAsses">
            <Found Context="routeData">
                @{
                    var controlType = routeData.PageType.AssemblyQualifiedName;
                    if(CurrentControl != controlType)
                    {
                        CurrentControl = controlType;
                        _ = SaveState();
                        InvokeAsync(StateHasChanged);
                    }
                }
                <CascadingValue Value="@routeData">
                    <RouteView RouteData="routeData" DefaultLayout="@DefaultLayout" />
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </CascadingValue>
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(RazorSharp.Layout.MainLayout)">
                    <NotFoundControl />
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
</div>

@code {
    public Type? DefaultLayout { get; set; } = typeof(RazorSharp.Layout.MainLayout);

    List<Assembly> EntryAsses {
        get
        {
            List<Assembly> entryAssemblies = [
                ..Trust.LoadedAssemblies.Values.GetMine()
    .Except(StoredAppAssembly != null ? [StoredAppAssembly] : [])
            ];
            Console.WriteLine("Entry: " + AppAssemblyName + " : " + JsonSerializer.Serialize(entryAssemblies.Select(ass => ass.ToName())));
            return entryAssemblies;
        }
    }
    protected string Ready = "loading";

    [JsonPropertyName(nameof(AppAssemblyName))]
    public static string? AppAssemblyName { get; set; } = null;
    public Assembly StoredAppAssembly {
        get => AppAssemblyName != null && Trust.LoadedAssemblies.TryGetValue(AppAssemblyName, out var ass)
            ? ass : DefaultLayout?.Assembly 
            ?? typeof(RazorSharp.Pages.Landing.Default).Assembly;
        set => AppAssemblyName = value.ToName();
    }

    public async Task SetAppAssembly(System.Reflection.Assembly? assembly)
    {
        if (assembly != null)
        {
            StoredAppAssembly = assembly;
            Ready = "layout"; // Explicitly move to layout
            //await InvokeAsync(StateHasChanged);
            await ProbablyUpdateTitle();
            await SaveState();
        }
    }
    IRenderState? Rendered = null;
    IServiceProvider? Provider = null;
    IJSRuntime? Runtime = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Rendered = Service.GetService<IRenderState>();
        Provider = Service.GetService<IServiceProvider>();
        Runtime = Provider?.GetService<IJSRuntime>();
        Nav.LocationChanged += Nav_LocationChanged;
        if (Runtime == null)
            Console.WriteLine("Error: Starting with no runtime. State won't work.");
        else
            Console.WriteLine("Note: Starting with runtime. State should work.");
        Rendered?.NotifyEmptied(Runtime);

    }


    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            if (Rendered?.RestoreState(this) is Task task) await task;
        }

        Console.WriteLine("Current route: " + CurrentControl);

        if (CurrentControl != null) {
            var controlType = CurrentControl.ToType();
            if (controlType != null) {
                //StoredAppAssembly = controlType.Assembly;
                await Css.ListenUp(controlType, DefaultLayout);
                Service.GetService<IFormFactor>()?.RequestControl = controlType;
            }
        }

        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _ = ProbablyUpdateTitle();
    }


    protected async Task SaveState()
    {
        if (CurrentControl != null)
        {
            var controlType = CurrentControl.ToType();
            await Css.ListenUp(controlType, DefaultLayout);
            Service.GetService<IFormFactor>()?.RequestControl = controlType;

            Console.WriteLine("Current route 2: " + CurrentControl + " - " + controlType);
            if (controlType != typeof(RazorSharp.Pages.Landing.Default))
            {
                Composite.GetService<IFormFactor>()?.RequestControl = controlType;
                _ = ProbablyUpdateTitle(controlType);
            }
        }
        if (!OperatingSystem.IsBrowser())
        {
            if (Rendered?.SetState(this) == true)
                await InvokeAsync(StateHasChanged);
        }   
    }


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Trust.OnSettledAsync += () => ProbablyUpdateTitle();
            Rendered?.NotifyRendered(Runtime);
        }

    }


    private void Nav_LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (IsClosing) return;
        Type? controlType = null;
        try
        {
            controlType = TypeExtensions.IdentifyNavigation(Nav.Uri).ComponentType;
        } catch {}

        if (string.IsNullOrWhiteSpace(Nav.Uri.Trim('/'))) Css.SetPageClasses(["Home"], controlType);
        else Css.SetPageClasses([..Nav.ToBaseRelativePath(Nav.Uri.Split('?')[0])
    .Split('/')
    .Select(seg => seg.ToSafe())
        ], controlType);

        Composite.GetService<IFormFactor>()?.RequestControl = controlType;
        _ = ProbablyUpdateTitle(controlType);
    }

    public object[] GetChildComponents() => [.. ComponentExtensions.GetChildComponents(this).Cast<object>()];
    public async Task HasChanged(ICompositeProvider Composite)
    {
        //await InvokeAsync(StateHasChanged);
    }

    bool IsClosing = false;

    public void Dispose()
    {
        IsClosing = true;
        //Trust.OnAssemblyLoaded -= NotifyAssembly;
        Rendered?.NotifyEmptied(null);
        Nav.LocationChanged -= Nav_LocationChanged;
        GC.SuppressFinalize(this);
    }

    private async Task ProbablyUpdateTitle(Type? controlType = null)
    {
        //await Css.ListenUp();
        if (IsClosing) return;
        var components = this
            .GetChildComponents()
            .Select(comp => comp.GetType())
            .Concat(controlType != null ? [controlType] : [])
            .OrderBy(type => type == controlType ? -2 : type != typeof(RazorSharp.Pages.Landing.Default) ? -1 : 0)
            .ToList();
        var title = components.SelectMany(comp => comp.GetCustomAttributes<DisplayAttribute>())
            .FirstOrDefault() ?? controlType?.GetCustomAttributes<DisplayAttribute>().FirstOrDefault();
        if (title is DisplayAttribute attr)
        {
            var Title = Service.GetService<ITitleService>();
            Title?.UpdateTitle(attr.Name);
            //await InvokeAsync(StateHasChanged);
        }
    }


    [JsonPropertyName(nameof(CurrentControl))]
    public string? CurrentControl { get; set; }

    private async Task HandleNavigation(NavigationContext args)
    {
        if (IsClosing) return;
        try
        {
            var controlType = TypeExtensions.IdentifyNavigation(args.Path).ComponentType;

            CurrentControl = controlType.AssemblyQualifiedName;

            if (controlType == typeof(RazorSharp.Pages.Landing.Default)) return;

            await Css.ListenUp(controlType, DefaultLayout);
            Service.GetService<IFormFactor>()?.RequestControl = controlType;

            _ = ProbablyUpdateTitle(controlType);


        } catch {}
    }
}
