@using Extensions.PrometheusTypes
@using Interfacing.Services
@using RazorSharp.Controls
@using RazorSharp.Extensions
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using System.Text.Json
@using System.Text.Json.Serialization
@implements IDisposable
@implements IHasChildren
@inject NavigationManager Nav
@inject IServiceProvider Service
@inject ITrustProvider Trust
@inject IJSRuntime JS
@inject IHasClass Css

@foreach (var cssUrl in Css.Registry)
{
    <link rel="stylesheet" href="@cssUrl" />
}
@*TODO: using the layout injection found below that way it only happens if there is a state set *@
@foreach (var item in Rendered?.State ?? [])
{
    <input type="hidden" name="state_@item.Key" value="@item.Value" />
}

<div class="page @(Ready) @(string.Join(" ", Css.ClassNames))">
    <CascadingValue Name="Loader" Value="@this">
        <Router OnNavigateAsync="HandleNavigation" 
                AppAssembly="@StoredAppAssembly"
                AdditionalAssemblies="@EntryAsses">
            <Found Context="routeData">
                @{
                    CurrentControl = routeData.PageType.AssemblyQualifiedName;
                    SaveState();
                }
                <CascadingValue Value="@routeData">
                    <RouteView RouteData="routeData" DefaultLayout="@DefaultLayout" />
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </CascadingValue>
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(RazorSharp.Layout.MainLayout)">
                    <NotFoundControl />
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
</div>

@code {
    public Type? DefaultLayout { get; set; } = typeof(RazorSharp.Layout.MainLayout);

    List<Assembly> EntryAsses {
        get
        {
            List<Assembly> entryAssemblies = [.. (Assembly.GetEntryAssembly()
    ?? Assembly.GetExecutingAssembly())
    .GetAssemblies().GetMine()
    .Except([typeof(WebClient.Components.App).Assembly])
                    ];
            Console.WriteLine("Entry: " + JsonSerializer.Serialize(entryAssemblies.Select(ass => ass.ToName())));
            return entryAssemblies;
        }
    }
    protected string Ready = "loading";

    static System.Reflection.Assembly? StoredAppAssembly = typeof(WebClient.Components.App).Assembly;
    public async Task SetAppAssembly(System.Reflection.Assembly? assembly)
    {
        StoredAppAssembly = assembly;
        if (StoredAppAssembly != null)
        {
            Ready = "layout"; // Explicitly move to layout
            //await InvokeAsync(StateHasChanged);
            _ = ProbablyUpdateTitle();
            _ = Css?.ListenUp(null, DefaultLayout, this);
        }
    }
    IRenderState? Rendered = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Rendered = Service.GetService<IRenderState>();
        Nav.LocationChanged += Nav_LocationChanged;

    }


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if (OperatingSystem.IsBrowser())
        {
            if(Rendered?.RestoreState(this) is Task task) await task;
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _ = ProbablyUpdateTitle();
    }


    protected void SaveState()
    {
        if (CurrentControl != null)
            Css.ListenUp(Type.GetType(CurrentControl), DefaultLayout, this);

        if (!OperatingSystem.IsBrowser())
        {
            if (Rendered?.SetState(this) == true)
                InvokeAsync(StateHasChanged);
        }        
    }


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Trust.OnSettledAsync += () => ProbablyUpdateTitle();
            Rendered?.NotifyRendered(JS, this);
        }

    }


    private void Nav_LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (IsClosing) return;
        Type? controlType = null;
        try
        {
            controlType = TypeExtensions.IdentifyNavigation(Nav.Uri).ComponentType;
        } catch {}

        if (string.IsNullOrWhiteSpace(Nav.Uri.Trim('/'))) Css.SetPageClasses(["Home"], controlType);
        else Css.SetPageClasses([..Nav.ToBaseRelativePath(Nav.Uri.Split('?')[0])
    .Split('/')
    .Select(seg => seg.ToSafe())
        ], controlType);

        _ = ProbablyUpdateTitle();
    }

    public object[] GetChildComponents() => [.. InvokableExtensions.GetChildComponents(this).Cast<object>()];
    public async Task HasChanged()
    {
        //await InvokeAsync(StateHasChanged);
    }

    bool IsClosing = false;

    public void Dispose()
    {
        IsClosing = true;
        //Trust.OnAssemblyLoaded -= NotifyAssembly;
        Rendered?.NotifyEmptied(this);
        Nav.LocationChanged -= Nav_LocationChanged;
        GC.SuppressFinalize(this);
    }

    private async Task ProbablyUpdateTitle(Type? controlType = null)
    {
        //await Css.ListenUp();
        if (IsClosing) return;
        var components = this
            .GetChildComponents()
            .Select(comp => comp.GetType())
            .OrderBy(type => type != typeof(RazorSharp.Pages.Landing.Default) ? -1 : 0)
            .ToList();
        var title = components.SelectMany(comp => comp.GetCustomAttributes<DisplayAttribute>())
            .FirstOrDefault() ?? controlType?.GetCustomAttributes<DisplayAttribute>().FirstOrDefault();
        if (title is DisplayAttribute attr)
        {
            var Title = Service.GetService<ITitleService>();
            Title?.UpdateTitle(attr.Name);
            //await InvokeAsync(StateHasChanged);
        }
    }


    [JsonPropertyName(nameof(CurrentControl))]
    public string? CurrentControl { get; set; }

    private async Task HandleNavigation(NavigationContext args)
    {
        if (IsClosing) return;
        try
        {
            var controlType = TypeExtensions.IdentifyNavigation(args.Path).ComponentType;

            CurrentControl = controlType.AssemblyQualifiedName;

            if (controlType == typeof(RazorSharp.Pages.Landing.Default)) return;

            await Css.ListenUp(controlType, DefaultLayout, this);
            
            _ = ProbablyUpdateTitle(controlType);


        } catch {}
    }
}
