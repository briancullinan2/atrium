@using Extensions.PrometheusTypes
@using Interfacing.Services
@using Microsoft.AspNetCore.Components.Infrastructure
@using Microsoft.AspNetCore.Components.RenderTree
@using RazorSharp.Controls
@using RazorSharp.Extensions
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@implements IDisposable
@implements IHasCurrent<App>
@implements IHasClass
@inject ICssOutlet Css
@inject IJavascriptOutlet JavaScript
@inject NavigationManager Nav
@inject ICompositeProvider Service


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="/_content/RazorSharp/css/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="icon" type="image/png" href="favicon.ico" />
    <AntiforgeryToken />
</head>

<body>
    @{
        Css.ChildContent(__builder);
        JavaScript.ChildContent(__builder);
    }
     
    <div class="page @(Ready) @(string.Join(" ", ClassNames))">
        <WebClient.Components.Routes @rendermode="PreferredMode" />
    </div>
    <script src="/_content/RazorSharp/main.js"></script>
    <script src="/_content/WebClient/blazor.web.js" autostart="false"></script>

    <script>
        document.addEventListener("DOMContentLoaded", startBlazor);
        
        manageServiceWorker();

    </script>

    @if (IsDebug)
    {
        <script>
            (function() {
            const originalInvoke = DotNet.invokeMethodAsync;
            DotNet.invokeMethodAsync = function(assemblyName, methodName, ...args) {
            console.log(`[JS Interop] Calling: ${methodName} in ${assemblyName}`, "Args:", args);
            return originalInvoke.apply(this, [assemblyName, methodName, ...args]);
            };
            })();
        </script>
    }


</body>

</html>

@code {

    public static App? Current { get; private set; } = null;

    public object[] GetChildComponents() => [..InvokableExtensions.GetChildComponents(this).Cast<object>()];

    // Default to Wasm, but allow an override
    IComponentRenderMode PreferredMode = RenderMode.InteractiveServer;

    private bool IsDebug = false;
    protected string Ready = "loading";

    public void HasChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        Current = this;

        base.OnInitialized();
#if DEBUG
        IsDebug = true;
#endif
        var Query = App.Query(Nav.Uri);
        if (Nav.Uri.Contains("#mode=server") == true)
        {
            PreferredMode = InteractiveServer;
        }
        else if (Query?.TryGetValue("mode", out var mode) == true)
        {
            PreferredMode = mode == "server"
                ? RenderMode.InteractiveServer
                : RenderMode.InteractiveWebAssembly;
        }

        Console.WriteLine($"Starting in {PreferredMode.ToString()} mode");

        Nav.LocationChanged += Nav_LocationChanged;

    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        //var context = Service.GetRequiredService<HttpContext>();
        //var store = context.RequestServices.GetService<IPersistentComponentStateStore>();
        //var manager = Service.GetRequiredService<ComponentStatePersistenceManager>();
        //var store = Service.GetRequiredService<IPersistentComponentStateStore>();
        //var renderer = Service.GetRequiredService<Renderer>();
        //await manager.PersistStateAsync(store, renderer);

    }


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var Page = Service.GetRequiredService<IRenderState>();
        await Page.SetState(this);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        

    }

    public static Dictionary<string, string> Query(string uri)
    {
        // Use a simple split/regex to avoid heavy libraries
        var query = uri.TrimStart('?');
        var parameters = query.Split('&')
                              .Select(p => p.Split('='))
                              .ToDictionary(p => p[0], p => p.Length > 1 ? Uri.UnescapeDataString(p[1]) : "");

        return parameters;
    }
    
    private List<string> GivenClassNames { get; set; } = [];
    public ClassNameCollection CombinedClassNames { get; } = [];
    public ClassNameCollection ClassNames { get => CombinedClassNames; set => GivenClassNames = [.. value]; }
    private List<string>? PageClasses = [];
    public string? Theme;
    public string? Sidebar { get; private set; }
    public string? Background;
    
    // TODO: move this to mainloader classes along side SetTitle
    public void SetPageClasses(List<string> classes)
    {
        PageClasses = classes;
    }

    public void SetTheme(string? classes)
    {
        var newClass = "theme-" + (classes?.ToLowerInvariant() ?? string.Empty);
        Theme = newClass;
    }

    public void SetSidebar(string? classes)
    {
        Sidebar = classes;
    }

    public void SetBackground(string? classes)
    {
        var newClass = "background-" + (classes?.ToLowerInvariant() ?? string.Empty);
        Background = newClass;
    }

    private void SetBackground(AnimationMode? theme)
    {
        var newClass = "background-" + (theme?.ToString()?.ToLowerInvariant() ?? string.Empty);
        Background = newClass;
    }
    
    private void Nav_LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(Nav.Uri.Trim('/'))) PageClasses = ["Home"];
        else PageClasses = [..Nav.ToBaseRelativePath(Nav.Uri.Split('?')[0])
            .Split('/')
            .Select(seg => seg.ToSafe())
        ];

        _ = ProbablyUpdateTitle();
    }

    public void Dispose()
    {
        //Trust.OnAssemblyLoaded -= NotifyAssembly;
        Nav.LocationChanged -= Nav_LocationChanged;
        GC.SuppressFinalize(this);
    }
    
    private async Task ProbablyUpdateTitle()
    {
        var components = this.GetChildComponents().OrderBy(comp => comp.GetType() != typeof(RazorSharp.Pages.Landing.Default) ? -1 : 0);
        var title = components.SelectMany(comp => comp.GetType().GetCustomAttributes<DisplayAttribute>())
            .FirstOrDefault();
        if (title is DisplayAttribute attr)
        {
            var Title = Service.GetService<ITitleService>();
            Title?.UpdateTitle(attr.Name);
        }
    }
}
